# UML 基础配置片段（附加到 defconfig 之后）
# 用法：EXTRA_CONFIG=config/uml-base.config ./build_uml.sh
CONFIG_STATIC_LINK=y
CONFIG_UML_NET_VECTOR=y
CONFIG_UML_NET=y
CONFIG_BLK_DEV_UBD=y
CONFIG_HOSTFS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_TMPFS=y
CONFIG_EXT4_FS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=n
CONFIG_TUN=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_CONSOLE_TRANSLATIONS=y
CONFIG_ANDROID_BINDERFS=n
# 精简体积：去除用不到的子系统
CONFIG_WERROR=n
CONFIG_MODULES=n
CONFIG_CPUSETS=n
